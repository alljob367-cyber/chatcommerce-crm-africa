# ═══════════════════════════════════════════════════
# ChatCommerce CRM Africa - Configuration
# ═══════════════════════════════════════════════════
# 1. Cree un projet gratuit sur https://console.neon.tech
# 2. Copie la connection string (Pooled) dans DATABASE_URL
# 3. Copie la connection string (Direct) dans DIRECT_DATABASE_URL
# ═══════════════════════════════════════════════════

# Neon Pooled Connection (pour les requetes depuis Vercel)
DATABASE_URL=

# Neon Direct Connection (pour les migrations Prisma)
DIRECT_DATABASE_URL=

# JWT Secret
JWT_SECRET=
