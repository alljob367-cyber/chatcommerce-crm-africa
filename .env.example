# ═══════════════════════════════════════════════════
# ChatCommerce CRM Africa - Configuration
# ═══════════════════════════════════════════════════
# 1. Cree un projet gratuit sur https://console.neon.tech
# 2. Copie la connection string (Pooled) dans DATABASE_URL
# ═══════════════════════════════════════════════════

# Neon PostgreSQL Connection String (Pooled)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret (min 16 chars)
JWT_SECRET=your-super-secret-jwt-key-change-me

# ═══════════════════════════════════════════════════
# Chariow Payment Gateway
# ═══════════════════════════════════════════════════
# Chariow API Key (trouvee sur https://merchant.chariow.com)
CHARIOW_API_KEY=your-chariow-api-key

# Chariow Webhook Secret (pour verifier les notifications de paiement)
CHARIOW_WEBHOOK_SECRET=your-chariow-webhook-secret

# Chariow Store Domain (votre boutique Chariow)
CHARIOW_STORE_DOMAIN=votre-boutique.mychariow.shop

# Produits Chariow — UN produit par plan avec le bon prix configure sur le dashboard Chariow.
# Chaque produit doit etre cree sur https://merchant.chariow.com avec le prix correspondant :
#   Starter   = 5 000 FCFA   → Creez un produit et copiez son ID ici
#   Pro       = 14 900 FCFA  → Creez un produit et copiez son ID ici
#   Business  = 29 900 FCFA  → Creez un produit et copiez son ID ici
#   Enterprise= 69 900 FCFA  → Creez un produit et copiez son ID ici
CHARIOW_PRODUCT_STARTER=prd_xxxxx_starter
CHARIOW_PRODUCT_PRO=prd_xxxxx_pro
CHARIOW_PRODUCT_BUSINESS=prd_xxxxx_business
CHARIOW_PRODUCT_ENTERPRISE=prd_xxxxx_enterprise
